# =========================
# AI Bus Booking System ENV Example
# =========================

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# GraphQL Gateway
GRAPHQL_GATEWAY_PORT=4000
WEB_ORIGIN=http://localhost:3000
ANALYTICS_SERVICE_URL=http://localhost:50056
TRIP_SERVICE_GRPC_ADDRESS=localhost:50051
BOOKING_SERVICE_GRPC_ADDRESS=localhost:50053
SEAT_INVENTORY_SERVICE_GRPC_ADDRESS=localhost:50052
SKIP_SEAT_CONFIRMATION=false

# Service Ports
TRIP_SERVICE_PORT=50051
SEAT_INVENTORY_SERVICE_PORT=50052
BOOKING_SERVICE_PORT=50053
PAYMENT_SERVICE_PORT=5010
PAYMENT_SERVICE_URL=http://localhost:5010
SKIP_PAYMENT_SERVICE=false
ANALYTICS_SERVICE_PORT=50056
MCP_SERVER_PORT=4010
BOOKING_GRPC_TARGET=localhost:50053
SEAT_INVENTORY_GRPC_URL=localhost:50052

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bus_booking
POSTGRES_USER=bus_app
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://bus_app:change_me_local_only@localhost:5432/bus_booking

# Redis
REDIS_URL=redis://localhost:6379
SEAT_HOLD_TTL_SECONDS=300

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SEARCH_EVENTS=search-events
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events
KAFKA_TOPIC_CHECKIN_EVENTS=checkin-events

# AI
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace_with_local_key_only
GRAPHQL_GATEWAY_URL=http://localhost:4000/graphql
MCP_ADMIN_TOKEN=replace_with_local_admin_token_only
MCP_SERVER_HOST=127.0.0.1
# Required only when MCP_SERVER_HOST is not localhost; comma-separated Host values.
MCP_ALLOWED_HOSTS=

# Simulated Email
EMAIL_MODE=log
EMAIL_FROM=demo-bus@example.com

# Auth
JWT_SECRET=change_me_local_only
# Encrypts short-lived checkout/payment/lookup context cookies; use a distinct random value outside local demo.
FLOW_CONTEXT_SECRET=change_me_local_only
JWT_EXPIRES_IN_SECONDS=28800

# Optional overrides (defaults shown; only set when needed)
# GRPC_CALL_TIMEOUT_MS=5000            # gateway -> service call deadline
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5  # consecutive unavailable/timeout failures before a downstream client trips open
# CIRCUIT_BREAKER_COOLDOWN_MS=10000    # how long an open breaker fails fast before allowing a half-open trial call
# TRIP_SEARCH_CACHE_TTL_SECONDS=60     # redis search cache TTL
# TRIP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
# DISABLE_RABBITMQ=true                # dev only: log workflow events instead of publishing
# DISABLE_KAFKA=true                   # dev only: log analytics events instead of publishing
