# =============================================================================
# apps/web (Next.js) local env example.
#
# WHY THIS FILE EXISTS: Next.js reads env files from THIS directory (apps/web/),
# NOT the repo-root .env. Server-side vars defined only in the root .env never
# reach the web app (that is why the chatbot could not see the Gemini key).
# Copy this file to `.env.local` here and fill in real values:
#     cp apps/web/.env.example apps/web/.env.local
# Restart `next dev` after any change -- env is read once at server startup,
# a browser refresh does NOT reload it.
# =============================================================================

# --- AI chatbot (Module 5) ---------------------------------------------------
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/api-keys).
# Required for the "Hoi AI" chat. The direct-tool buttons work without it.
GOOGLE_GENERATIVE_AI_API_KEY=replace_with_gemini_key

# Chat model. The in-code default (gemini-2.5-flash) is blocked for new
# accounts, so pin an available model here.
GOOGLE_MODEL=gemini-flash-latest

# --- GraphQL gateway ---------------------------------------------------------
# Server-side gateway URL (SSR pages, chatbot tools, gateway lib).
GRAPHQL_GATEWAY_URL=http://localhost:4000/graphql

# Browser-exposed URLs (baked into the client bundle at build time).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# --- Auth / flow signing -----------------------------------------------------
# Must match the gateway's values (root .env) so JWTs and flow context verify.
JWT_SECRET=change_me_local_only
FLOW_CONTEXT_SECRET=change_me_local_only

# --- Tests only --------------------------------------------------------------
# Postgres URL used by the web e2e demo seeding (apps/web/tests). Not needed
# to run the app in dev.
DATABASE_URL=postgresql://bus_app:change_me_local_only@localhost:5432/bus_booking
