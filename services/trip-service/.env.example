# Trip Service local config example.
# Copy to .env for local runs. The service also reads the repo root .env if present.
# Never commit a real .env.

TRIP_SERVICE_PORT=50051
TRIP_SERVICE_HOST=0.0.0.0

# PostgreSQL (source of truth for trip-domain data)
DATABASE_URL=postgresql://bus_app:change_me_local_only@localhost:5432/bus_booking

# Redis (optional: search cache + popular-route counters). Service degrades gracefully if absent.
REDIS_URL=redis://localhost:6379
TRIP_SEARCH_CACHE_TTL_SECONDS=60

# Kafka (optional: analytics search events). Service degrades gracefully if absent.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SEARCH_EVENTS=search-events

# Display timezone used for departure-date matching and SEO titles
TRIP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
